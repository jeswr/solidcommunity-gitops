{
  "comment": "solidcommunity.net: upstream CSS components only, with Mashlib as the UI. Pick an identifier strategy in the entry config (solidcommunity.net.json or test.json).",
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "import": [
    "css:config/app/init/initialize-root.json",
    "css:config/app/main/default.json",
    "css:config/app/variables/default.json",
    "css:config/http/handler/default.json",
    "css:config/http/middleware/default.json",
    "css:config/http/notifications/all.json",
    "css:config/http/server-factory/http.json",
    "css:config/http/static/default.json",
    "css:config/identity/access/public.json",
    "css:config/identity/email/example.json",
    "css:config/identity/handler/default.json",
    "css:config/identity/oidc/default.json",
    "css:config/identity/ownership/token.json",
    "css:config/identity/pod/static.json",
    "css:config/ldp/authentication/dpop-bearer.json",
    "css:config/ldp/authorization/webacl.json",
    "css:config/ldp/handler/default.json",
    "css:config/ldp/metadata-parser/default.json",
    "css:config/ldp/metadata-writer/default.json",
    "css:config/ldp/modes/default.json",
    "css:config/storage/backend/file.json",
    "css:config/storage/key-value/resource-store.json",
    "css:config/storage/location/pod.json",
    "css:config/storage/middleware/default.json",
    "css:config/util/auxiliary/acl.json",
    "css:config/util/logging/winston.json",
    "css:config/util/representation-conversion/default.json",
    "css:config/util/resource-locker/memory.json",
    "css:config/util/variables/default.json"
  ],
  "@graph": [
    {
      "comment": "Single process, so locks stay in memory (as on the DigitalOcean server). Expire idle locks after 30 s and cap any lock at 60 s.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ResourceLocker" },
      "overrideParameters": {
        "@type": "WrappedExpiringReadWriteLocker",
        "expiration": 30000,
        "maxHoldDuration": 60000
      }
    },
    {
      "comment": "Keep the locker's read counts in memory, like the locks themselves. Upstream writes a counter file on every read, which costs a round trip to the file share each time.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:LockStorage" },
      "overrideParameters": { "@type": "MemoryMapStorage" }
    },
    {
      "comment": "Create a public, read-only root container on first start.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:RootFolderGenerator" },
      "overrideParameters": {
        "@type": "StaticFolderGenerator",
        "templateFolder": "templates/root",
        "resourcesGenerator": { "@id": "urn:solid-server:default:TemplatedResourcesGenerator" }
      }
    },
    {
      "comment": "SolidOS pod layout (inbox, settings, type indexes), same as SolidOS/css-mashlib.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:PodResourcesGenerator" },
      "overrideParameters": {
        "@type": "StaticFolderGenerator",
        "templateFolder": "templates/pod"
      }
    },
    {
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:PodCreator" },
      "overrideParameters": {
        "@type": "BasePodCreator",
        "relativeWebIdPath": "profile/card#me"
      }
    },
    {
      "comment": "Lets accounts migrated from NSS log in with their old username.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:PasswordLoginHtml" },
      "overrideParameters": {
        "@type": "HtmlViewEntry",
        "filePath": "./templates/identity/password/login.html.ejs",
        "route": { "@id": "urn:solid-server:default:LoginPasswordRoute" }
      }
    },
    {
      "comment": "Sign-up also creates the account's Pod and WebID, so every account starts with one.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:RegisterPasswordAccountHtml" },
      "overrideParameters": {
        "@type": "HtmlViewEntry",
        "filePath": "./templates/identity/password/register.html.ejs",
        "route": { "@id": "urn:solid-server:default:RegisterPasswordRoute" }
      }
    },
    {
      "comment": "Simple account page (Pod, WebID, email, password) with the upstream lists under Advanced.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:AccountIdHtml" },
      "overrideParameters": {
        "@type": "HtmlViewEntry",
        "filePath": "./templates/identity/account/resource.html.ejs",
        "route": { "@id": "urn:solid-server:default:AccountIdRoute" }
      }
    },
    {
      "comment": "App consent page that shows the person's name instead of WebID and client IDs.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:OidcConsentHtml" },
      "overrideParameters": {
        "@type": "HtmlViewEntry",
        "filePath": "./templates/identity/oidc/consent.html.ejs",
        "route": { "@id": "urn:solid-server:default:OidcConsentRoute" }
      }
    },
    {
      "comment": "solidcommunity.net look (ODI and Solid branding) for every account, login and error page.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:MainTemplateEngine" },
      "overrideParameters": {
        "@type": "StaticTemplateEngine",
        "templateEngine": { "@id": "urn:solid-server:default:TemplateEngine" },
        "template": "./templates/main.html.ejs"
      }
    },
    {
      "comment": "Serve the Mashlib databrowser as the default HTML representation.",
      "@id": "urn:solid-server:default:DefaultUiConverter",
      "@type": "ConstantConverter",
      "contentType": "text/html",
      "filePath": "./node_modules/mashlib/dist/databrowser.html",
      "options_container": true,
      "options_document": true,
      "options_minQuality": 1,
      "options_disabledMediaRanges": [ "image/*", "application/pdf" ]
    },
    {
      "comment": "Mashlib renders Markdown itself.",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:ChainedConverter" },
      "overrideSteps": [{
        "@type": "OverrideListRemove",
        "overrideParameter": { "@id": "ChainedConverter:_converters" },
        "overrideTarget": { "@id": "urn:solid-server:default:MarkdownToHtmlConverter" }
      }]
    },
    {
      "comment": "Serve the Mashlib bundle from the server root, and the solidcommunity.net stylesheet, script and logo under /.well-known/sc/.",
      "@id": "urn:solid-server:default:StaticAssetHandler",
      "@type": "StaticAssetHandler",
      "assets": [
        {
          "@type": "StaticAssetEntry",
          "relativeUrl": "/",
          "filePath": "./node_modules/mashlib/dist/"
        },
        {
          "@type": "StaticAssetEntry",
          "relativeUrl": "/.well-known/sc/",
          "filePath": "./templates/static/"
        }
      ]
    }
  ]
}
