{
  "comment": "Benchmark ablation: in-memory lock/cookie/OIDC state and client-credential cache, no read cache.",
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-cached-storage/^0.0.0/components/context.jsonld"
  ],
  "@graph": [
    {
      "comment": "Read counts of the read-write locker in memory, like the locks themselves.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:LockStorage"
      },
      "overrideParameters": {
        "@type": "MemoryMapStorage"
      }
    },
    {
      "comment": "Login cookies in memory: users log in again after a restart.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:CookieStorage"
      },
      "overrideParameters": {
        "@type": "WrappedExpiringStorage",
        "source": {
          "@type": "ContainerPathStorage",
          "relativePath": "/accounts/cookies/",
          "source": {
            "@type": "MemoryMapStorage"
          }
        }
      }
    },
    {
      "comment": "OIDC provider state in memory, except dynamically registered clients, which stay on disk.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:IdpAdapterFactory"
      },
      "overrideParameters": {
        "@type": "ClientCredentialsAdapterFactory",
        "webIdStore": {
          "@id": "urn:solid-server:default:WebIdStore"
        },
        "clientCredentialsStore": {
          "@id": "urn:solid-server:default:ClientCredentialsStore"
        },
        "source": {
          "@type": "ClientIdAdapterFactory",
          "converter": {
            "@id": "urn:solid-server:default:RepresentationConverter"
          },
          "source": {
            "@type": "ExpiringAdapterFactory",
            "storage": {
              "@type": "WrappedExpiringStorage",
              "source": {
                "@type": "MemoryMapStorage"
              }
            },
            "clientStorage": {
              "@type": "WrappedExpiringStorage",
              "source": {
                "@type": "ContainerPathStorage",
                "relativePath": "/idp/adapter/",
                "source": {
                  "@id": "urn:solid-server:default:KeyValueStorage"
                }
              }
            }
          }
        }
      }
    },
    {
      "comment": "Client-credential lookups from memory.",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:solid-server:default:ClientCredentialsStore"
      },
      "overrideParameters": {
        "@type": "CachingClientCredentialsStore",
        "source": {
          "@type": "BaseClientCredentialsStore",
          "storage": {
            "@id": "urn:solid-server:default:AccountStorage"
          }
        }
      }
    }
  ]
}
