<div class="split">
  <section class="split-intro">
    <h1>Log in</h1>
    <p class="lead">Log in to manage your Solid Pod and WebID, or to continue to the app that sent you here.</p>
    <% if (authenticating) { %>
    <div class="note note-app"><p>An app has asked you to log in. Once you have logged in, you choose which WebID it may use.</p></div>
    <% } %>
    <div class="note">
      <p>Accounts created after December 2024 log in with their <strong>email address</strong>. Older accounts log in with their <strong>username</strong>.</p>
    </div>
  </section>

  <form method="post" id="mainForm" class="card">
    <p class="error" id="error"></p>

    <fieldset>
      <legend class="hidden">Your account</legend>
      <ol>
        <li>
          <label for="email">Email or username</label>
          <input id="email" type="text" name="email" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
        </li>
        <li>
          <label for="password">Password</label>
          <input id="password" type="password" name="password" autocomplete="current-password">
        </li>
        <li class="checkbox">
          <label><input type="checkbox" name="remember" value="true" checked>Stay logged in</label>
        </li>
      </ol>
    </fieldset>

    <p class="actions">
      <button type="submit" name="submit" disabled>Log in</button>
      <button class="hidden" type="button" id="cancel">Cancel</button>
    </p>

    <ul class="actions">
      <li><a id="forgot-link" href="" class="link">Forgot password?</a></li>
      <li>New here? <a id="register-link" href="" class="link">Sign up</a></li>
    </ul>
  </form>
</div>


<script>
  (async() => {
    let controls = await fetchControls('<%= idpIndex %>');

    // Only show the cancel button if there is an OIDC interaction
    setVisibility('cancel', <%= authenticating %>);
    getElements('cancel').cancel.addEventListener('click', async() => {
      const res = await fetch(controls.oidc.cancel, { method: 'POST' });
      location.href = (await res.json()).location;
    });

    addPostListener(async() => {
      const json = await postJsonForm(controls.password.login, false,
        (json) => Object.assign(json, {
          remember: Boolean(json.remember),
          // Accounts migrated from NSS log in with their old username, stored as <username>@users.css.pod.
          email: json.email.includes('@') ? json.email : `${json.email}@users.css.pod`,
        }));
      // In case there was no forced OIDC redirect, just go to the main account page
      if (json) {
        // Now with cookie
        controls = await fetchControls('<%= idpIndex %>');
        location.href = controls.html.account.account;
      }
    });

    updateElement('register-link', controls.html.password.register, { href: true });
    updateElement('forgot-link', controls.html.password.forgot, { href: true });
  })();
</script>
