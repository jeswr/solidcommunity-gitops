<h1>Your account</h1>
<p class="error" id="error"></p>
<p class="success hidden" id="success"></p>

<p class="actions hidden" id="oidcActions">
  <button type="button" id="oidc" class="primary">Continue to the app</button>
</p>

<section class="tile" id="podTile">
  <h2>Your Pod</h2>
  <div id="podInfo" class="hidden">
    <dl class="facts">
      <dt>Pod</dt>
      <dd><a id="podUrl" href=""></a></dd>
      <dt>WebID</dt>
      <dd><a id="webIdUrl" href=""></a></dd>
    </dl>
    <p class="hint">Your WebID is your identity on the Solid web. Use it to log in to Solid apps.</p>
    <p class="tile-actions">
      <a class="btn btn-primary" id="openPod" href="">Open your Pod</a>
      <a class="btn btn-secondary" id="openProfile" href="">View your profile</a>
    </p>
  </div>
  <div id="noPod" class="hidden">
    <p>You don't have a Pod yet. Create one to get your own storage and a WebID.</p>
    <p class="tile-actions"><a class="btn btn-primary" id="createFirstPod" href="">Create your Pod</a></p>
  </div>
</section>

<section class="tile" id="loginTile">
  <h2>Login details</h2>
  <dl class="facts">
    <dt id="loginLabel">Email</dt>
    <dd id="loginEmail"></dd>
  </dl>
  <p class="hint hidden" id="usernameHint">
    You log in with a username from before December 2024. Add an email address so that you can reset your password if you forget it.
  </p>
  <p class="tile-actions">
    <button type="button" id="showEmailForm">Change email</button>
    <a class="btn btn-secondary" id="changePassword" href="">Change password</a>
  </p>

  <form method="post" id="emailForm" class="hidden inline-form">
    <p class="error" id="emailError"></p>
    <fieldset>
      <legend>Change email</legend>
      <ol>
        <li>
          <label for="newEmail">New email address</label>
          <input id="newEmail" type="email" name="email" autocomplete="email">
        </li>
        <li>
          <label for="currentPassword">Current password</label>
          <input id="currentPassword" type="password" name="password" autocomplete="current-password">
        </li>
      </ol>
    </fieldset>
    <p class="actions">
      <button type="submit">Save email</button>
      <button type="button" id="cancelEmail">Cancel</button>
    </p>
  </form>
</section>

<p class="actions">
  <button type="button" id="logout" name="logout">Log out</button>
</p>

<details class="advanced" id="advanced">
  <summary>Advanced settings</summary>
  <p>Extra logins, more Pods, WebIDs from other servers, and tokens for scripts and servers.</p>

  <div id="passwordLogins">
    <h2>Email/password logins</h2>
    <p>The email/password logins used to identify this account.</p>
    <a id="createPasswordLogin" href="" class="link">Add login</a>
    <ul id="passwordLoginEntries"></ul>
  </div>

  <div id="pods">
    <h2>Pods</h2>
    <p>The pods created by this account.</p>
    <a id="createPod" href="" class="link">Create pod</a>
    <ul id="podEntries"></ul>
  </div>

  <div id="webIds">
    <h2>Registered Web IDs</h2>
    <p>
      These are the WebIDs you can authenticate as using this account.
      These WebIDs also have full control access to the pods registered for this account.
    </p>
    <a id="linkWebId" href="" class="link">Link WebID</a>
    <ul id="webIdEntries"></ul>
  </div>

  <div id="clientCredentials">
    <h2>Credential tokens</h2>
    <p>The tokens created by this account.</p>
    <a id="createCredentials" href="" class="link">Create token</a>
    <ul id="clientCredentialsEntries"></ul>
  </div>
</details>

<script>
  const elements = getElements('passwordLoginEntries', 'podEntries', 'webIdEntries', 'clientCredentialsEntries', 'oidc', 'logout',
    'emailForm', 'showEmailForm', 'cancelEmail');

  (async() => {
    const controls = await fetchControls('<%= idpIndex %>');

    // Button to continue OIDC session if there is one,
    // in case someone needed to create/update the account during a session.
    setVisibility('oidcActions', <%= authenticating %>);
    elements.oidc.addEventListener('click', async() => {
      const body = await fetchJson(controls.oidc.prompt);
      location.href = body.location;
    });

    elements.logout.addEventListener('click', async() => {
      await fetch(controls.account.logout, { method: 'POST' });
      location.href = controls.html.main.login;
    });

    // ----- Simple view: the first login, Pod and WebID -----

    const { passwordLogins = {} } = await fetchJson(controls.password.create);
    const { pods = {} } = controls.account.pod ? await fetchJson(controls.account.pod) : {};
    const { webIdLinks = {} } = controls.account.webId ? await fetchJson(controls.account.webId) : {};

    const [ login, loginUrl ] = Object.entries(passwordLogins)[0] ?? [];
    const podUrl = Object.keys(pods)[0];
    // Prefer the WebID that lives in the Pod (the one created with it), else the first linked one.
    const webIds = Object.keys(webIdLinks);
    const webId = webIds.find((id) => podUrl && id.startsWith(podUrl)) ?? webIds[0];

    if (podUrl) {
      updateElement('podUrl', podUrl, { innerText: true, href: true });
      updateElement('openPod', podUrl, { href: true });
      if (webId) {
        updateElement('webIdUrl', webId, { innerText: true, href: true });
        updateElement('openProfile', webId, { href: true });
      }
      setVisibility('podInfo', true);
    } else if (controls.html.account.createPod) {
      updateElement('createFirstPod', controls.html.account.createPod, { href: true });
      setVisibility('noPod', true);
    } else {
      setVisibility('podTile', false);
    }

    if (login) {
      // Accounts migrated from NSS log in with their old username, stored as <username>@users.css.pod.
      const isUsername = login.endsWith('@users.css.pod');
      updateElement('loginLabel', isUsername ? 'Username' : 'Email', { innerText: true });
      updateElement('loginEmail', isUsername ? login.slice(0, -'@users.css.pod'.length) : login, { innerText: true });
      setVisibility('usernameHint', isUsername);
      if (isUsername) {
        elements.showEmailForm.innerText = 'Add email';
      }
      updateElement('changePassword', loginUrl, { href: true });
    } else {
      setVisibility('loginTile', false);
    }

    elements.showEmailForm.addEventListener('click', () => {
      setVisibility('emailForm', true);
      document.getElementById('newEmail').focus();
    });
    elements.cancelEmail.addEventListener('click', () => {
      elements.emailForm.reset();
      setVisibility('emailForm', false);
    });

    // CSS has no "change email" call, so this checks the current password,
    // adds a login with the new email and the same password, then removes the old login.
    elements.emailForm.addEventListener('submit', async(event) => {
      event.preventDefault();
      const { email, password } = Object.fromEntries(new FormData(elements.emailForm));
      setError('', 'emailError');
      try {
        if (!email || !password) {
          throw new Error('Enter your new email address and your current password.');
        }
        let res = await postJson(loginUrl, { oldPassword: password, newPassword: password });
        if (res.status >= 400) {
          throw new Error('Your current password is not correct.');
        }
        res = await postJson(controls.password.create, { email, password });
        if (res.status >= 400) {
          throw new Error((await res.json()).message);
        }
        res = await fetch(loginUrl, { method: 'DELETE' });
        if (res.status >= 400) {
          throw new Error(`Your new email was added, but the old login could not be removed: ${(await res.json()).message}`);
        }
        updateElement('loginLabel', 'Email', { innerText: true });
        updateElement('loginEmail', email, { innerText: true });
        updateElement('success', `Your email is now ${email}. Use it the next time you log in.`, { innerText: true });
        setVisibility('success', true);
        // Reload so the links (change password, advanced lists) point at the new login.
        setTimeout(() => location.reload(), 2500);
      } catch (error) {
        setError(error.message, 'emailError');
      }
    });

    // ----- Advanced view: the upstream lists, unchanged -----

    updateElement('createPasswordLogin', controls.password.create, { href: true });
    showAccountInfo(elements.passwordLoginEntries, passwordLogins, true, true,
      'Are you sure you want to delete this login method? This will prevent you from logging in to your account with these credentials.');

    if (!controls.html.account.createPod && Object.keys(pods).length === 0) {
      setVisibility('pods', false);
    } else {
      updateElement('createPod', controls.html.account.createPod, { href: true });
      showAccountInfo(elements.podEntries, pods, true, false);
    }

    if (!controls.html.account.linkWebId && webIds.length === 0) {
      setVisibility('webIds', false);
    } else {
      updateElement('linkWebId', controls.html.account.linkWebId, { href: true });
      showAccountInfo(elements.webIdEntries, webIdLinks, false, true,
        'Are you sure you want to delete the registration of this WebID? ' +
        'If you do so you will be unable to identify as this WebID using this server, which can potentially cause you to lose access to data restricted to this WebID.',
        'Make sure to remove the relevant solid:oidcIssuer triple from the WebID to prevent existing access tokens from still being used.');
    }

    const { clientCredentials = {} } = controls.account.clientCredentials ? await fetchJson(controls.account.clientCredentials) : {};
    if (!controls.html.account.createClientCredentials && Object.keys(clientCredentials).length === 0) {
      setVisibility('clientCredentials', false);
    } else {
      // The create link is hidden if the account has no WebIDs.
      updateElement('createCredentials', webIds.length && controls.html.account.createClientCredentials, { href: true });
      showAccountInfo(elements.clientCredentialsEntries, clientCredentials, false, true,
        'Are you sure you want to delete this token? This will prevent this token from being used in the future.');
    }
  })();

  // Adds account info to the UI
  function showAccountInfo(rootElement, data, addUpdate, addDel, confirmMsg, finishMsg) {
    for (const [ key, url ] of Object.entries(data)) {
      const li = document.createElement('li');
      if (/^https?:\/\//.test(key)) {
        li.insertAdjacentHTML('beforeend', `<a href="${key}">${key}</a>`);
      } else {
        li.append(key);
      }
      if (addUpdate) {
        li.insertAdjacentHTML('beforeend', ` <a href="${url}">(update)</a>`);
      }
      if (addDel) {
        const del = createUrlDeleteElement(li, url, { method: 'DELETE' }, confirmMsg, finishMsg);
        li.append(' ');
        li.append(del);
      }
      rootElement.append(li);
    }
  }
</script>
